# ============================================
# NEXUS-AGENT - Variables de Entorno
# ============================================
# Solo necesitas configurar esto:

# Tu API Key de HuggingFace (OBLIGATORIO)
# Obtén una gratis en: https://huggingface.co/settings/tokens
HF_API_KEY=tu_hf_api_key_aqui

# Base de datos MySQL (OPCIONAL)
# Si no la configuras, las tareas no se guardan entre reinicios
# DATABASE_URL=mysql://usuario:password@host:3306/nexus_db

# Puerto del servidor (opcional, por defecto 3000)
# PORT=3000
